# Stripe secret key (server-side only) — required for the client intake checkout to work.
STRIPE_SECRET_KEY=

# Client intake fee, in cents. Defaults to 4900 ($49.00) if unset.
NEXT_PUBLIC_INTAKE_FEE_CENTS=4900

# Supabase project URL, e.g. https://kpjimvatrekrryqsbuby.supabase.co
SUPABASE_URL=

# Supabase service role key (server-side only, NEVER expose to the browser).
# Dashboard -> Project Settings -> API -> Project API keys -> service_role
SUPABASE_SERVICE_ROLE_KEY=
